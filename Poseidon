import numpy as np
import random


# ----------------------------------------------------------------------
# F_{2^8}
# ----------------------------------------------------------------------

POLY = 0x11B
EXP = np.zeros(512, dtype=np.uint8)
LOG = np.zeros(256, dtype=np.int16)


def _build_tables():
    e = 1
    for i in range(255):
        EXP[i], LOG[e] = e, i
        e2 = e << 1
        if e2 & 0x100:
            e2 ^= POLY
        e = e2 ^ e
    EXP[255:510] = EXP[0:255]
    EXP[510], EXP[511] = EXP[0], EXP[1]


_build_tables()


def gmul(a, b):
    a = np.asarray(a, dtype=np.uint8)
    b = np.asarray(b, dtype=np.uint8)
    r = EXP[LOG[a].astype(np.int32) + LOG[b].astype(np.int32)]
    return np.where((a == 0) | (b == 0), np.uint8(0), r).astype(np.uint8)


def ginv(a):
    a = np.asarray(a, dtype=np.uint8)
    return np.where(a == 0, np.uint8(0), EXP[(255 - LOG[a]) % 255]).astype(np.uint8)


def smul(a, b):
    return 0 if a == 0 or b == 0 else int(EXP[(int(LOG[a]) + int(LOG[b])) % 255])


def sinv(a):
    return int(EXP[(255 - int(LOG[a])) % 255])


def spow(a, e):
    r = 1
    x = a
    while e:
        if e & 1:
            r = smul(r, x)
        x = smul(x, x)
        e >>= 1
    return r


# ----------------------------------------------------------------------
# Small-scale Poseidon2b instance
# ----------------------------------------------------------------------

t = 6
R_F = 4
R_P = 6
R_f = R_F // 2

_rng = random.Random(20240718)


def _cauchy_mds(width):
    while True:
        pts = _rng.sample(range(1, 256), 2 * width)
        X, Y = pts[:width], pts[width:]
        if len(set(X) | set(Y)) == 2 * width:
            return [[sinv(X[i] ^ Y[j]) for j in range(width)] for i in range(width)]


M_E = _cauchy_mds(t)
MU = [_rng.randrange(2, 256) for _ in range(t)]
RC_E = [[_rng.randrange(256) for _ in range(t)] for _ in range(R_F)]
RC_I = [_rng.randrange(256) for _ in range(R_P)]


def sbox(x):
    x2 = gmul(x, x)
    x4 = gmul(x2, x2)
    return gmul(gmul(x4, x2), x)


def _mat_mul(M, state):
    out = []
    for i in range(t):
        acc = np.zeros_like(state[0])
        for j in range(t):
            if M[i][j]:
                acc ^= gmul(state[j], np.uint8(M[i][j]))
        out.append(acc)
    return out


def _internal_mul(state):
    # y_i = (mu_i + 1)x_i + sum_j x_j in characteristic two.
    s = np.zeros_like(state[0])
    for x in state:
        s ^= x
    return [gmul(state[i], np.uint8(MU[i] ^ 1)) ^ s for i in range(t)]


def permutation(state):
    state = _mat_mul(M_E, state)

    for r in range(R_f):
        state = [sbox(state[i] ^ np.uint8(RC_E[r][i])) for i in range(t)]
        state = _mat_mul(M_E, state)

    for r in range(R_P):
        state = [sbox(state[0] ^ np.uint8(RC_I[r]))] + state[1:]
        state = _internal_mul(state)

    for r in range(R_f, R_F):
        state = [sbox(state[i] ^ np.uint8(RC_E[r][i])) for i in range(t)]
        state = _mat_mul(M_E, state)

    return state


# ----------------------------------------------------------------------
# Fibers of x -> x^D
# ----------------------------------------------------------------------

D = 17
Q = 256
NUM_FIBERS_TOTAL = ((Q - 1) // D) ** 4


def fiber_points(m):
    # The subgroup of D-th roots of unity is generated by g^15.
    return [int(EXP[(m + 15 * j) % 255]) for j in range(D)]


def fiber_constant(m):
    return spow(int(EXP[m % 255]), D)


# ----------------------------------------------------------------------
# Polynomial utilities over F_{2^8}
# ----------------------------------------------------------------------

def _mat_inv(M):
    n = len(M)
    A = [row[:] + [1 if i == j else 0 for j in range(n)]
         for i, row in enumerate(M)]

    for k in range(n):
        p = next(r for r in range(k, n) if A[r][k])
        A[k], A[p] = A[p], A[k]

        iv = sinv(A[k][k])
        A[k] = [smul(iv, v) for v in A[k]]

        for r in range(n):
            if r != k and A[r][k]:
                f = A[r][k]
                A[r] = [A[r][j] ^ smul(f, A[k][j])
                        for j in range(2 * n)]

    return [row[n:] for row in A]


def interpolation_matrix(points):
    return _mat_inv([
        [spow(s, k) for k in range(len(points))]
        for s in points
    ])


def interpolate(VINV, values):
    # Values (..., D) on one fiber -> coefficients (..., D).
    out = np.zeros_like(values)
    for i in range(len(VINV)):
        acc = np.zeros(values.shape[:-1], dtype=np.uint8)
        for j in range(len(VINV)):
            if VINV[i][j]:
                acc ^= gmul(values[..., j], np.uint8(VINV[i][j]))
        out[..., i] = acc
    return out


def poly_trim(p):
    p = list(p)
    while p and p[-1] == 0:
        p.pop()
    return p


def poly_mod(a, b):
    a, b = poly_trim(a), poly_trim(b)
    ib = sinv(b[-1])

    while a and len(a) >= len(b):
        f = smul(a[-1], ib)
        shift = len(a) - len(b)
        for i in range(len(b)):
            a[shift + i] ^= smul(f, b[i])
        a = poly_trim(a)

    return a


def poly_gcd(a, b):
    a, b = poly_trim(a), poly_trim(b)
    while b:
        a, b = b, poly_mod(a, b)

    if a:
        iv = sinv(a[-1])
        a = [smul(iv, c) for c in a]
    return a


def poly_eval(p, x):
    r = 0
    for c in reversed(p):
        r = smul(r, x) ^ c
    return r


# ----------------------------------------------------------------------
# Resultant evaluation
# ----------------------------------------------------------------------

def _degree_rows(C):
    # Exact degree of each coefficient row, -1 for the zero polynomial.
    nz = (C != 0)
    has = nz.any(axis=1)
    rev = np.argmax(nz[:, ::-1], axis=1)
    deg = C.shape[1] - 1 - rev
    deg = deg.astype(np.int16)
    deg[~has] = -1
    return deg


def _sylvester_exact(A, B, da, db):
    # A and B contain ascending coefficients.
    N = A.shape[0]
    n = da + db
    S = np.zeros((N, n, n), dtype=np.uint8)

    Ad = A[:, :da + 1][:, ::-1]
    Bd = B[:, :db + 1][:, ::-1]

    for i in range(db):
        S[:, i, i:i + da + 1] = Ad
    for i in range(da):
        S[:, db + i, i:i + db + 1] = Bd

    return S


def _det_batch(A):
    A = A.copy()
    N, n, _ = A.shape
    det = np.full(N, 1, dtype=np.uint8)
    rows = np.arange(N)

    for k in range(n):
        pivot = np.argmax(A[:, k:, k] != 0, axis=1) + k

        tmp = A[rows, k, :].copy()
        A[rows, k, :] = A[rows, pivot, :]
        A[rows, pivot, :] = tmp

        p = A[:, k, k].copy()
        det = gmul(det, p)

        inv_p = ginv(np.where(p == 0, np.uint8(1), p))
        if k + 1 < n:
            f = gmul(A[:, k + 1:, k], inv_p[:, None])
            A[:, k + 1:, :] ^= gmul(f[:, :, None], A[:, k, None, :])

    return det


def resultant(V1, V2, VINV):
    """
    Exact resultant with respect to the last variable.

    V1 and V2 are values on one D-point fiber.  We first interpolate the
    reduced representatives and then group rows by their actual degrees.
    This avoids treating a polynomial of degree < D-1 as if its degree
    were exactly D-1.
    """
    shape = V1.shape[:-1]

    C1 = interpolate(VINV, V1).reshape(-1, D)
    C2 = interpolate(VINV, V2).reshape(-1, D)

    d1 = _degree_rows(C1)
    d2 = _degree_rows(C2)

    out = np.zeros(C1.shape[0], dtype=np.uint8)

    for da in range(D):
        for db in range(D):
            idx = np.where((d1 == da) & (d2 == db))[0]
            if len(idx) == 0:
                continue

            if da == 0 and db == 0:
                # Standard convention Res(a,b)=1 for two nonzero constants.
                out[idx] = 1
            elif da == 0:
                # Res(a,B)=a^{deg B}.
                vals = np.full(len(idx), 1, dtype=np.uint8)
                a = C1[idx, 0]
                for _ in range(db):
                    vals = gmul(vals, a)
                out[idx] = vals
            elif db == 0:
                # Res(A,b)=b^{deg A}.
                vals = np.full(len(idx), 1, dtype=np.uint8)
                b = C2[idx, 0]
                for _ in range(da):
                    vals = gmul(vals, b)
                out[idx] = vals
            else:
                S = _sylvester_exact(C1[idx], C2[idx], da, db)
                out[idx] = _det_batch(S)

    # If either polynomial is zero, the resultant is zero.
    return out.reshape(shape)


def fiber_resultant(V):
    # Res_x(p, x^D-c) = product over the D points of the fiber.
    out = np.full(V.shape[:-1], 1, dtype=np.uint8)
    for j in range(V.shape[-1]):
        out = gmul(out, V[..., j])
    return out


# ----------------------------------------------------------------------
# CICO-2 resultant chain
# ----------------------------------------------------------------------

def cico2_attack(m):
    """
    m contains four representatives of the sampled fibers.

    Elimination:
        x4 -> x3 -> x2
    followed by a GCD with x1^D-c1 and direct verification.
    """
    X = [fiber_points(mi) for mi in m]
    VINV = [interpolation_matrix(S) for S in X]

    grid = np.meshgrid(
        *[np.array(S, dtype=np.uint8) for S in X],
        indexing="ij"
    )
    zero = np.zeros_like(grid[0])

    output = permutation([
        grid[0], grid[1], grid[2], grid[3], zero, zero
    ])
    f1, f2 = output[4], output[5]

    # Eliminate x4.
    g1 = resultant(f1, f2, VINV[3])
    g2 = fiber_resultant(f1)
    g3 = fiber_resultant(f2)

    # Eliminate x3.
    h1 = resultant(g1, g2, VINV[2])
    h2 = resultant(g1, g3, VINV[2])
    h3 = fiber_resultant(g1)

    # Eliminate x2.
    y1 = resultant(h1, h2, VINV[1])
    y2 = resultant(h1, h3, VINV[1])
    y3 = fiber_resultant(h1)

    # GCD with x1^D-c1.
    modulus = [0] * (D + 1)
    modulus[D] = 1
    modulus[0] = fiber_constant(m[0])

    G = modulus
    for y in (y1, y2, y3):
        coeffs = interpolate(VINV[0], y).astype(int)
        G = poly_gcd(G, poly_trim(list(coeffs)))
        if not G:
            return []

    x1_candidates = [
        i for i, x1 in enumerate(X[0])
        if poly_eval(G, x1) == 0
    ]

    # Back-substitution on the fixed fiber.
    #
    # Record the size of each recovery frontier.  These statistics make
    # explicit how many candidates survive successive resultant elimination
    # before direct verification against the original permutation.
    partial_x12 = 0
    partial_x123 = 0
    solutions = []

    for i1 in x1_candidates:
        for i2 in range(D):
            if h1[i1, i2] or h2[i1, i2] or h3[i1, i2]:
                continue
            partial_x12 += 1

            for i3 in range(D):
                if g1[i1, i2, i3] or g2[i1, i2, i3] or g3[i1, i2, i3]:
                    continue
                partial_x123 += 1

                for i4 in range(D):
                    if f1[i1, i2, i3, i4] == 0 and f2[i1, i2, i3, i4] == 0:
                        solutions.append((
                            X[0][i1], X[1][i2], X[2][i3], X[3][i4]
                        ))

    recovery_stats = {
        "final_gcd_roots": len(x1_candidates),
        "partial_x12": partial_x12,
        "partial_x123": partial_x123,
        "max_partial_candidates": max(
            len(x1_candidates), partial_x12, partial_x123
        ),
        "complete_candidates": len(solutions),
    }

    return solutions, recovery_stats


def verify(solution, m):
    state = [np.uint8([x]) for x in solution]
    state += [np.uint8([0]), np.uint8([0])]

    output = permutation(state)

    cico_ok = (
        int(output[4][0]) == 0 and
        int(output[5][0]) == 0
    )
    fiber_ok = all(
        spow(solution[i], D) == fiber_constant(m[i])
        for i in range(4)
    )

    return cico_ok and fiber_ok


# ----------------------------------------------------------------------
# Experiment reported in the paper
# ----------------------------------------------------------------------

def decode_fiber_tuple(a):
    m = []
    for _ in range(4):
        m.append(a % 15)
        a //= 15
    return m


def run_experiment(num_fibers=100, seed=1):
    rng = random.Random(seed)
    indices = rng.sample(range(NUM_FIBERS_TOTAL), num_fibers)

    total_solutions = 0
    nonempty_fibers = 0
    verified_solutions = 0

    total_final_gcd_roots = 0
    max_final_gcd_roots = 0

    total_partial_x12 = 0
    max_partial_x12 = 0

    total_partial_x123 = 0
    max_partial_x123 = 0

    max_partial_candidates = 0
    total_complete_candidates = 0
    rejected_by_verification = 0

    for a in indices:
        m = decode_fiber_tuple(a)
        solutions, stats = cico2_attack(m)

        total_final_gcd_roots += stats["final_gcd_roots"]
        max_final_gcd_roots = max(
            max_final_gcd_roots, stats["final_gcd_roots"]
        )

        total_partial_x12 += stats["partial_x12"]
        max_partial_x12 = max(max_partial_x12, stats["partial_x12"])

        total_partial_x123 += stats["partial_x123"]
        max_partial_x123 = max(max_partial_x123, stats["partial_x123"])

        max_partial_candidates = max(
            max_partial_candidates, stats["max_partial_candidates"]
        )
        total_complete_candidates += stats["complete_candidates"]

        verified_this_fiber = 0
        for solution in solutions:
            if verify(solution, m):
                verified_solutions += 1
                verified_this_fiber += 1
            else:
                rejected_by_verification += 1

        total_solutions += verified_this_fiber
        nonempty_fibers += int(verified_this_fiber > 0)

    expected_solutions = D**4 / Q**2
    predicted_nonempty = 1.0 - (1.0 - 1.0 / Q**2) ** (D**4)

    print("Poseidon2b CICO-2 experimental validation")
    print("field                              = F_{2^8}")
    print("t, R_F, R_P, D                    = %d, %d, %d, %d"
          % (t, R_F, R_P, D))
    print("distinct random fibers            = %d" % num_fibers)
    print("roots after final GCD             = %d total, %.4f average, %d max"
          % (total_final_gcd_roots,
             total_final_gcd_roots / num_fibers,
             max_final_gcd_roots))
    print("partial candidates after x2       = %d total, %.4f average, %d max"
          % (total_partial_x12,
             total_partial_x12 / num_fibers,
             max_partial_x12))
    print("partial candidates after x3       = %d total, %.4f average, %d max"
          % (total_partial_x123,
             total_partial_x123 / num_fibers,
             max_partial_x123))
    print("maximum partial candidates        = %d" % max_partial_candidates)
    print("complete candidates pre-verify    = %d" % total_complete_candidates)
    print("rejected by final verification    = %d" % rejected_by_verification)
    print("verified recovered solutions      = %d" % verified_solutions)
    print("nonempty fibers                   = %d" % nonempty_fibers)
    print("average solutions per fiber       = %.4f"
          % (total_solutions / num_fibers))
    print("empirical nonempty probability    = %.2f%%"
          % (100.0 * nonempty_fibers / num_fibers))
    print("theoretical solutions per fiber   = %.4f"
          % expected_solutions)
    print("theoretical nonempty probability  = %.2f%%"
          % (100.0 * predicted_nonempty))

    return {
        "total_solutions": total_solutions,
        "verified_solutions": verified_solutions,
        "nonempty_fibers": nonempty_fibers,
        "average_solutions": total_solutions / num_fibers,
        "empirical_nonempty_probability": nonempty_fibers / num_fibers,
        "theoretical_solutions_per_fiber": expected_solutions,
        "theoretical_nonempty_probability": predicted_nonempty,
        "total_final_gcd_roots": total_final_gcd_roots,
        "average_final_gcd_roots": total_final_gcd_roots / num_fibers,
        "max_final_gcd_roots": max_final_gcd_roots,
        "total_partial_x12": total_partial_x12,
        "average_partial_x12": total_partial_x12 / num_fibers,
        "max_partial_x12": max_partial_x12,
        "total_partial_x123": total_partial_x123,
        "average_partial_x123": total_partial_x123 / num_fibers,
        "max_partial_x123": max_partial_x123,
        "max_partial_candidates": max_partial_candidates,
        "total_complete_candidates": total_complete_candidates,
        "rejected_by_verification": rejected_by_verification,
    }


if __name__ == "__main__":
    run_experiment()
